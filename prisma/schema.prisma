generator client {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  googleId  String?  @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       StudentProfile?
  applications  Application[]
  saved         SavedScholarship[]
  documents     StudentDocument[]
  notifications Notification[]
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  dateOfBirth DateTime?
  gender      String?
  state       String?
  district    String?
  ruralUrban  String?

  college             String?
  course              String?
  branch              String?
  yearOfStudy         Int?
  semester            Int?
  currentPercentage   Float?
  currentCGPA         Float?
  previousQualification String?
  previousPercentage  Float?

  annualFamilyIncome  Float?
  incomeCertificate   Boolean?
  ews                 Boolean?
  dependents          Int?

  category            String?
  disabilityStatus    String?
  additionalInfo      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scholarship {
  id          String   @id @default(cuid())
  name        String
  provider    String
  description String?
  amount      Float?
  startDate   DateTime?
  deadline    DateTime?

  educationLevel String?
  course         String?
  branch         String?
  state          String?
  incomeLimit    Float?

  applicationUrl String?
  source         String?
  verified       Boolean  @default(false)
  lastVerified   DateTime?
  active         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saved        SavedScholarship[]
  applications Application[]
}

model SavedScholarship {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  scholarshipId String
  status        ApplicationStatus @default(NOT_STARTED)
  referenceNo   String?
  submissionDate DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
}

model StudentDocument {
  id         String   @id @default(cuid())
  userId     String
  name       String
  type       String
  url        String
  expiryDate DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
enum Role {
  STUDENT
  ADMIN
}

enum ApplicationStatus {
  NOT_STARTED
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  READY_TO_SUBMIT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}